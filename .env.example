# ───────────────────────────────────────────────────────────────────────────
# MediChain backend — copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit it.
# ───────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
# Comma-separated list of origins allowed to call the API. Use * for dev.
CORS_ORIGIN=*

# ── Supabase ───────────────────────────────────────────────────────────────
# Project settings → API
SUPABASE_URL=
# "anon public" key — used for auth + user-scoped (RLS) queries
SUPABASE_ANON_KEY=
# "service_role" key — used for privileged server-only operations
# (wallet custody, guaranteed profile creation). KEEP THIS SECRET.
SUPABASE_SERVICE_ROLE_KEY=

# ── Pinata (IPFS pinning) ──────────────────────────────────────────────────
# app.pinata.cloud → API Keys → New Key (enable pinFileToIPFS scope)
PINATA_JWT=
# Gateways tab → copy your subdomain (without https://)
PINATA_GATEWAY=
# ── Blockchain (MediAccessControl contract) ────────────────────────────────
# JSON-RPC endpoint. For a local Hardhat node running on the SAME machine as
# this backend use http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# EIP-155 chain id (31337 = local Hardhat, 80002 = Polygon Amoy, 137 = mainnet)
BLOCKCHAIN_CHAIN_ID=31337
# Address MediAccessControl was deployed to
CONTRACT_ADDRESS=

# ── Wallet custody ─────────────────────────────────────────────────────────
# 32-byte hex (64 chars) key used to encrypt each user's Ethereum private key
# at rest in the `user_wallets` table. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=change-me-64-hex-chars

# ── Email (optional) ───────────────────────────────────────────────────────
# Resend API key for appointment-confirmation emails. Leave blank to disable.
RESEND_API_KEY=
# "From" address shown on confirmation emails.
EMAIL_FROM=MediChain <onboarding@resend.dev>
